{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\"" }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "echo 'reminder: load the snapshot'" } ] }
    ]
  }
}
